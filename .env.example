# --- triage engine ---------------------------------------------------------------
# rule_based (default, no credentials) or llm
TRIAGE_ENGINE=llm

# --- DeepSeek (primary) ----------------------------------------------------------
DEEPSEEK_API_KEY=
TRIAGE_DEEPSEEK_MODEL=deepseek-flash
TRIAGE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# instructor: tool schema + validation + repair (DeepSeek has no strict json_schema output)
TRIAGE_DEEPSEEK_ENFORCEMENT=instructor

# --- OpenAI (fallback) -----------------------------------------------------------
OPENAI_API_KEY=
TRIAGE_OPENAI_MODEL=gpt-4o-mini
TRIAGE_OPENAI_BASE_URL=https://api.openai.com/v1
# sdk_parse: official structured outputs (strict: true, enforced during generation)
TRIAGE_OPENAI_ENFORCEMENT=sdk_parse

# --- LLM behaviour ---------------------------------------------------------------
TRIAGE_LLM_TIMEOUT_SECONDS=30
TRIAGE_LLM_MAX_ATTEMPTS=3            # tenacity transport attempts per provider
TRIAGE_LLM_MAX_VALIDATION_RETRIES=2  # instructor / repair turns
TRIAGE_LLM_FALLBACK_ENABLED=true

# --- service ---------------------------------------------------------------------
TRIAGE_DATABASE_PATH=var/triage.db
TRIAGE_LOG_LEVEL=INFO
# TRIAGE_LOG_JSON=true
